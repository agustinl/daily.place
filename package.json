{
	"name": "daily.place",
	"version": "7.1.0",
	"description": "Create your perfect space to focus on your daily tasks.",
	"private": true,
	"scripts": {
		"dev": "next dev",
		"build": "npx convex codegen && next build",
		"start": "next start",
		"lint": "next lint",
		"tsc": "tsc",
		"knip": "knip",
		"prepare": "husky",
		"test": "jest",
		"test:watch": "jest --watch",
		"test:coverage": "jest --coverage",
		"test:ci": "jest --ci --coverage --maxWorkers=2",
		"convex:dev": "npx convex dev",
		"convex:deploy": "npx convex deploy",
		"test:e2e": "playwright test",
		"test:convex": "vitest run",
		"format": "prettier --write \"src/**/*.{ts,tsx,js,css}\" \"convex/**/*.ts\" \"e2e/**/*.ts\" \"*.{js,ts,mts}\"",
		"format:check": "prettier --check \"src/**/*.{ts,tsx,js,css}\" \"convex/**/*.ts\" \"e2e/**/*.ts\" \"*.{js,ts,mts}\""
	},
	"dependencies": {
		"@clerk/nextjs": "^6.39.9",
		"@feedback-fish/react": "^1.2.2",
		"@hello-pangea/dnd": "^18.0.1",
		"@mantine/core": "^7.15.3",
		"@mantine/form": "^7.15.3",
		"@mantine/hooks": "^7.15.3",
		"@mantine/notifications": "^7.15.3",
		"@tabler/icons-react": "^3.28.1",
		"convex": "^1.50.0",
		"date-fns": "^2.29.3",
		"datocms-structured-text-to-html-string": "^2.1.11",
		"js-confetti": "^0.13.1",
		"linkify-react": "^4.4.0",
		"linkifyjs": "^4.1.0",
		"next": "^15.5.29",
		"next-intl": "^4.4.0",
		"react": "18.2.0",
		"react-dom": "18.2.0",
		"react-player": "^2.12.0"
	},
	"devDependencies": {
		"@edge-runtime/vm": "^5.0.0",
		"@playwright/test": "^1.65.0",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/react": "^16.3.0",
		"@types/jest": "^30.0.0",
		"@types/node": "^20.10.6",
		"@types/react": "^18.2.46",
		"@types/react-dom": "^18.2.4",
		"@typescript-eslint/eslint-plugin": "^8.72.2",
		"@typescript-eslint/parser": "^8.72.2",
		"convex-test": "^0.0.71",
		"eslint": "^8.57.1",
		"eslint-config-next": "^15.5.29",
		"eslint-plugin-import": "^2.29.1",
		"husky": "^9.1.7",
		"jest": "^30.2.0",
		"jest-environment-jsdom": "^30.2.0",
		"jest-localstorage-mock": "^2.4.26",
		"knip": "^5.66.2",
		"prettier": "^3.10.1",
